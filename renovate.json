{
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard"
  ],
  "includePaths": [
    "website/package.json"
  ],
  "enabledManagers": [
    "npm"
  ],
  "branchPrefix": "renovate/",
  "automergeType": "pr",
  "automerge": true,
  "platformAutomerge": true,
  "baseBranchPatterns": [
    "series/2.x"
  ],
  "packageRules": [
    {
      "description": "Update Official ZIO Ecosystem Docs - including pre-releases",
      "matchBaseBranches": [
        "series/2.x"
      ],
      "labels": [
        "dependencies",
        "documentation"
      ],
      "matchPackageNames": [
        "@zio.dev/**"
      ],
      "ignoreUnstable": false,
      "enabled": true
    },
    {
      "description": "Visual effects use the Effect v3 API (Context.GenericTag); v4 removed it and crashes the homepage",
      "matchPackageNames": [
        "effect"
      ],
      "allowedVersions": "<4.0.0"
    },
    {
      "description": "Disable patch updates for non-ZIO npm packages",
      "matchPackageNames": [
        "^(?!@zio\\.dev\\/)"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "enabled": false
    }
  ]
}
